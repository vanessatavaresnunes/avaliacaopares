<%- include('../layouts/main', { title: title, body: `
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="fas fa-user-plus me-2"></i>
                    Cadastrar Novo Aluno
                </h4>
            </div>
            <div class="card-body">
                <form method="POST" action="/professor/cadastrar-aluno">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="nome" class="form-label">Nome Completo</label>
                                <input type="text" class="form-control" id="nome" name="nome" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="turma" class="form-label">Turma</label>
                                <select class="form-select" id="turma" name="turma" required>
                                    <option value="">Selecione a turma</option>
                                    <% for(let i = 1; i <= 30; i++) { %>
                                        <option value="T<%= i.toString().padStart(2, '0') %>">T<%= i.toString().padStart(2, '0') %></option>
                                    <% } %>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="grupo" class="form-label">Grupo</label>
                                <select class="form-select" id="grupo" name="grupo" required>
                                    <option value="">Selecione o grupo</option>
                                    <% for(let i = 1; i <= 10; i++) { %>
                                        <option value="G<%= i %>">G<%= i %></option>
                                    <% } %>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Importante:</strong> O aluno será cadastrado sem senha. Na primeira vez que ele fizer login com seu email, será solicitado que defina uma senha pessoal.
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="/dashboard" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>
                            Voltar
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-2"></i>
                            Cadastrar Aluno
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
` }) %>
