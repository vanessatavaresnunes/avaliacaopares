<%- include('../layouts/main', { title: title, aluno: aluno, body: `
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>
                <i class="fas fa-chart-bar me-2"></i>
                Resultados das Avaliações - Sprint <%= sprint %>
            </h2>
            <div>
                <a href="/aluno/selecionar-sprint" class="btn btn-outline-secondary me-2">
                    <i class="fas fa-exchange-alt me-1"></i>
                    Trocar Sprint
                </a>
                <a href="/dashboard" class="btn btn-secondary">
                    <i class="fas fa-home me-1"></i>
                    Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-chart-pie me-2"></i>
                    Estatísticas
                </h5>
            </div>
            <div class="card-body">
                <% if (estatisticas.total_avaliacoes > 0) { %>
                    <div class="text-center mb-3">
                        <h3 class="text-primary"><%= estatisticas.media_notas.toFixed(1) %></h3>
                        <p class="text-muted mb-0">Média Geral</p>
                    </div>
                    
                    <table class="table table-borderless table-sm">
                        <tr>
                            <td><strong>Total de Avaliações:</strong></td>
                            <td><%= estatisticas.total_avaliacoes %></td>
                        </tr>
                        <tr>
                            <td><strong>Menor Nota:</strong></td>
                            <td><span class="badge bg-danger"><%= estatisticas.menor_nota %></span></td>
                        </tr>
                        <tr>
                            <td><strong>Maior Nota:</strong></td>
                            <td><span class="badge bg-success"><%= estatisticas.maior_nota %></span></td>
                        </tr>
                    </table>
                <% } else { %>
                    <div class="text-center text-muted py-3">
                        <i class="fas fa-chart-line fa-2x mb-2"></i>
                        <p>Nenhuma avaliação recebida ainda.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>
                    Avaliações Recebidas
                </h5>
            </div>
            <div class="card-body">
                <% if (avaliacoesRecebidas.length === 0) { %>
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-star fa-3x mb-3"></i>
                        <h5>Nenhuma avaliação recebida</h5>
                        <p>Você ainda não recebeu avaliações dos seus colegas na Sprint <%= sprint %>.</p>
                        <p class="small">Peça para seus colegas avaliarem você também!</p>
                    </div>
                <% } else { %>
                    <!-- Avaliações organizadas por eixo -->
                    <% eixos.forEach(function(eixo) { %>
                        <% if (avaliacoesPorEixo[eixo.id] && avaliacoesPorEixo[eixo.id].length > 0) { %>
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-chart-line me-2"></i>
                                        <%= eixo.nome %>
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <% avaliacoesPorEixo[eixo.id].forEach(function(avaliacao) { %>
                                            <div class="col-md-6 mb-3">
                                                <div class="card h-100">
                                                    <div class="card-body">
                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                            <h6 class="card-title mb-0">
                                                                <i class="fas fa-user me-1"></i>
                                                                <%= avaliacao.avaliador_nome %>
                                                            </h6>
                                                            <span class="badge bg-primary fs-6">
                                                                <%= avaliacao.nota %>
                                                            </span>
                                                        </div>
                                                        
                                                        <p class="card-text text-muted small">
                                                            <i class="fas fa-quote-left me-1"></i>
                                                            "<%= avaliacao.feedback %>"
                                                        </p>
                                                        
                                                        <small class="text-muted">
                                                            <i class="fas fa-clock me-1"></i>
                                                            <%= new Date(avaliacao.created_at).toLocaleDateString('pt-BR') %>
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<% if (avaliacoesRecebidas.length > 0) { %>
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-lightbulb me-2"></i>
                    Análise dos Resultados
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Pontos Positivos:</h6>
                        <ul class="list-unstyled">
                            <li><i class="fas fa-check text-success me-2"></i>Sua média geral é de <strong><%= estatisticas.media_notas.toFixed(1) %></strong></li>
                            <% if (estatisticas.maior_nota >= 4) { %>
                                <li><i class="fas fa-star text-warning me-2"></i>Recebeu nota máxima de <strong><%= estatisticas.maior_nota %></strong></li>
                            <% } %>
                            <li><i class="fas fa-users text-info me-2"></i><%= estatisticas.total_avaliacoes %> colegas avaliaram seu desempenho</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6>Áreas de Melhoria:</h6>
                        <ul class="list-unstyled">
                            <% if (estatisticas.media_notas < 3) { %>
                                <li><i class="fas fa-exclamation-triangle text-warning me-2"></i>Sua média está abaixo de 3.0</li>
                            <% } %>
                            <% if (estatisticas.menor_nota <= 2) { %>
                                <li><i class="fas fa-arrow-down text-danger me-2"></i>Recebeu nota mínima de <strong><%= estatisticas.menor_nota %></strong></li>
                            <% } %>
                            <li><i class="fas fa-target text-primary me-2"></i>Foque em melhorar para a próxima sprint</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<% } %>
` }) %>
