<%- include('../layouts/main', { title: title, aluno: aluno, body: `
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>
                <i class="fas fa-users me-2"></i>
                Avaliar Colegas - Sprint <%= sprint %>
            </h2>
            <div>
                <a href="/aluno/selecionar-sprint" class="btn btn-outline-secondary me-2">
                    <i class="fas fa-exchange-alt me-1"></i>
                    Trocar Sprint
                </a>
                <a href="/dashboard" class="btn btn-secondary">
                    <i class="fas fa-home me-1"></i>
                    Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    Informações da Avaliação
                </h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless table-sm">
                    <tr>
                        <td><strong>Aluno:</strong></td>
                        <td><%= aluno.nome %></td>
                    </tr>
                    <tr>
                        <td><strong>Turma:</strong></td>
                        <td><span class="badge bg-secondary"><%= aluno.turma %></span></td>
                    </tr>
                    <tr>
                        <td><strong>Grupo:</strong></td>
                        <td><span class="badge bg-info"><%= aluno.grupo %></span></td>
                    </tr>
                    <tr>
                        <td><strong>Sprint:</strong></td>
                        <td><span class="badge bg-primary">Sprint <%= sprint %></span></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>
                    Colegas de Equipe para Avaliar
                </h5>
            </div>
            <div class="card-body">
                <% if (colegas.length === 0) { %>
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-user-friends fa-3x mb-3"></i>
                        <h5>Nenhum colega encontrado</h5>
                        <p>Não há colegas de equipe na Sprint <%= sprint %> para avaliar.</p>
                        <p class="small">Verifique se outros alunos do seu grupo estão na mesma sprint.</p>
                        <a href="/aluno/selecionar-sprint" class="btn btn-primary">
                            <i class="fas fa-exchange-alt me-2"></i>
                            Trocar Sprint
                        </a>
                    </div>
                <% } else { %>
                    <div class="row">
                        <% colegas.forEach(function(colega) { %>
                            <div class="col-md-6 mb-3">
                                <div class="card h-100 <%= colega.percentualCompleto === 100 ? 'border-success' : colega.percentualCompleto > 0 ? 'border-warning' : 'border-secondary' %>">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="card-title mb-0"><%= colega.nome %></h6>
                                            <div class="text-end">
                                                <% if (colega.percentualCompleto === 100) { %>
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check me-1"></i>
                                                        Completo
                                                    </span>
                                                <% } else if (colega.percentualCompleto > 0) { %>
                                                    <span class="badge bg-warning">
                                                        <i class="fas fa-clock me-1"></i>
                                                        <%= colega.percentualCompleto %>%
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">
                                                        <i class="fas fa-circle me-1"></i>
                                                        Pendente
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <p class="card-text text-muted small mb-3">
                                            <i class="fas fa-envelope me-1"></i>
                                            <%= colega.email %>
                                        </p>
                                        
                                        <!-- Progresso por eixo -->
                                        <div class="mb-3">
                                            <small class="text-muted d-block mb-2">Progresso por eixo:</small>
                                            <% eixos.forEach(function(eixo) { %>
                                                <div class="d-flex align-items-center mb-1">
                                                    <small class="me-2" style="width: 120px;"><%= eixo.nome %>:</small>
                                                    <% if (colega.avaliacoesPorEixo[eixo.id]) { %>
                                                        <span class="badge bg-success me-2">✓</span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary me-2">○</span>
                                                    <% } %>
                                                </div>
                                            <% }); %>
                                        </div>
                                        
                                        <div class="d-grid">
                                            <a href="/aluno/avaliar-colega/<%= colega.id %>" class="btn btn-primary btn-sm">
                                                <i class="fas fa-star me-1"></i>
                                                <%= colega.percentualCompleto === 100 ? 'Revisar Avaliação' : 'Avaliar' %>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    
                    <div class="mt-4">
                        <div class="alert alert-info">
                            <i class="fas fa-lightbulb me-2"></i>
                            <strong>Dica:</strong> Avalie todos os seus colegas de equipe para ter uma visão completa do desempenho do grupo.
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
` }) %>
