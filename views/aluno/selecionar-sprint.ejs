<%- include('../layouts/main', { title: title, aluno: aluno, body: `
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header text-center">
                <h4 class="mb-0">
                    <i class="fas fa-tasks me-2"></i>
                    Selecionar Sprint para Avaliação
                </h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Olá <%= aluno.nome %>!</strong><br>
                    Selecione qual sprint você deseja avaliar. Você avaliará seus colegas de equipe (mesma turma e grupo) que estão na mesma sprint.
                </div>
                
                <form method="POST" action="/aluno/processar-sprint">
                    <div class="mb-4">
                        <label for="sprint" class="form-label">
                            <strong>Sprint para Avaliação</strong>
                        </label>
                        <select class="form-select form-select-lg" id="sprint" name="sprint" required>
                            <option value="">Selecione uma sprint</option>
                            <% for(let i = 1; i <= 5; i++) { %>
                                <option value="<%= i %>" <%= aluno.sprint_atual === i ? 'selected' : '' %>>
                                    Sprint <%= i %>
                                </option>
                            <% } %>
                        </select>
                        <div class="form-text">
                            <i class="fas fa-users me-1"></i>
                            Você avaliará colegas da <strong><%= aluno.turma %></strong> - <strong><%= aluno.grupo %></strong> na sprint selecionada.
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="/dashboard" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>
                            Voltar ao Dashboard
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-play me-2"></i>
                            Iniciar Avaliações
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center text-muted">
                <small>
                    <i class="fas fa-lightbulb me-1"></i>
                    <strong>Dica:</strong> Você pode alterar a sprint a qualquer momento e avaliar diferentes sprints.
                </small>
            </div>
        </div>
    </div>
</div>
` }) %>
